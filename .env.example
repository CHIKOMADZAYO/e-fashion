# Django
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app
SECURE_SSL_REDIRECT=True

# Database (Vercel Postgres or external PostgreSQL)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Media storage (S3-compatible - required on Vercel since filesystem is read-only)
USE_S3=True
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=

# Safaricom Daraja (M-Pesa)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=your-shortcode
MPESA_PASSKEY=your-passkey
MPESA_CALLBACK_URL=https://your-app.vercel.app/api/payments/callback/stk/
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# OpenAI (optional - support chat)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Email (for order confirmations)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com
